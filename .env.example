# ServerForge Configuration

# Web Dashboard & API server
PORT=3000
HOST=0.0.0.0

# Public hostname or IP shown to friends in Discord & UI (e.g., your Tailscale IP, DDNS, or LAN IP)
PUBLIC_HOST=localhost

# Runtime mode:
#   native - Local native processes directly on this server PC (default — no Docker needed)
#   auto   - Enables both Native and Docker (if Docker Engine is running)
#   docker - Docker containers only
#   mock   - Simulated runtime for testing & UI previews without game downloads
RUNTIME_MODE=native

# Optional: custom data directory (defaults to ./data)
# DATA_DIR=./data

# Optional: custom JWT signing secret (auto-generated and persisted in data/ if omitted)
# JWT_SECRET=change-me-to-a-long-random-string

# Discord Bot Integration (leave empty to run Web Dashboard only)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# CurseForge Modded Minecraft Integration (optional; can also be set in Web Dashboard Settings)
# Get a free API key at https://console.curseforge.com/
CURSEFORGE_API_KEY=
