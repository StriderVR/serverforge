{
  "name": "serverforge",
  "version": "1.0.0",
  "private": true,
  "description": "One-click game server manager & Discord temporary boot orchestrator for Windows 11 and Linux",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @serverforge/server --filter @serverforge/web dev",
    "dev:mock": "RUNTIME_MODE=mock pnpm --parallel --filter @serverforge/server --filter @serverforge/web dev",
    "build": "pnpm --filter @serverforge/shared build && pnpm --filter @serverforge/server build && pnpm --filter @serverforge/web build",
    "bundle:exe": "node scripts/build-exe-bundle.mjs",
    "start": "node packages/server/dist/index.js",
    "start:mock": "RUNTIME_MODE=mock node packages/server/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.0.0"
  }
}
